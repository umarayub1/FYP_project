# ── LLM Provider ──────────────────────────────────────────────────────────────
# Switch between 'external' (cloud) and 'local' (Ollama) with no code changes
LLM_PROVIDER=external          # external | anthropic | local
LLM_MODEL=claude-haiku-4-5-20251001  # model name for the chosen provider

# Cloud LLM keys
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...

# Local LLM (used when LLM_PROVIDER=local)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3            # any model pulled in Ollama (llama3, mistral, gemma3, etc.)

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# ── Databases ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://mongodb:27017/synapse
CHROMA_HOST=chromadb
# Docker-internal port: container listens on 8000; host maps 8001:8000 in compose.
# Use 8000 when running inside docker compose; 8001 for direct host access outside Docker.
CHROMA_PORT=8000

# ── Redis (task queue + pub/sub) ──────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Auth — Magic link only — no passwords stored ──────────────────────────────
JWT_SECRET=replace_with_64_random_chars
JWT_REFRESH_SECRET=replace_with_another_64_random_chars
# Shared secret for gateway → core-service internal calls. Generate with: openssl rand -hex 32
INTERNAL_SECRET=
# Magic link token signing key. Generate with: openssl rand -hex 32
MAGIC_LINK_SECRET=
MAGIC_LINK_EXPIRY_MINUTES=10
# Resend email delivery (https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── Service URLs (inter-service communication inside Docker) ──────────────────
CORE_SERVICE_URL=http://core-service:4001
AI_ENGINE_URL=http://ai-engine:8000

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
# Used for magic link email URLs and auth redirects
FRONTEND_URL=http://localhost:3000

# ── Quotas (graceful degradation thresholds) ──────────────────────────────────
QUOTA_TOKENS_FREE=200000
QUOTA_PDFS_FREE=10
QUOTA_FEYNMAN_FREE=20

# ── File Uploads ──────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=50  # Maximum PDF upload size in megabytes

# ── Ingestion Worker Retry Policy ────────────────────────────────────────────
# Terminal failures land on `{queue}-dead` for ops visibility.
INGEST_MAX_ATTEMPTS=3
INGEST_RETRY_DELAY_S=2.0
