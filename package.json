{
  "name": "synapse",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "prosemirror-view": "1.33.7"
  },
  "scripts": {
    "build": "npm run build -w @synapse/shared-types && npm run build -w @synapse/gateway && npm run build -w @synapse/core-service",
    "dev:gateway": "npm run dev -w @synapse/gateway",
    "dev:core": "npm run dev -w @synapse/core-service",
    "dev:frontend": "npm run dev -w @synapse/frontend"
  }
}
